{
  "name": "trek",
  "productName": "Trek",
  "version": "0.7.0",
  "description": "Multi-worktree Claude workspace manager",
  "license": "MIT",
  "homepage": "https://github.com/gettrekapp/trek",
  "main": "out/main/index.js",
  "desktopName": "trek.desktop",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/postinstall.mjs",
    "dev": "npm run build:server && electron-vite dev",
    "build": "electron-vite build && npm run build:web && npm run build:server",
    "build:web": "vite build --config vite.web.config.ts",
    "build:server": "npm --prefix server run build && node scripts/bundle-server.mjs",
    "build:relay": "npm --prefix relay run build",
    "build:example-theme": "node plugins/example-theme/build.mjs",
    "typecheck:relay": "npm --prefix relay run typecheck",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-timeout=600000 scripts/*.test.mjs",
    "test:bot-sandbox-mac": "TREK_SANDBOX_APP_TEST=1 node --test scripts/botSandboxMac.test.mjs",
    "test:bot-sandbox-linux": "node scripts/bot-sandbox-linux.mjs",
    "smoke:windows": "npm run build && node scripts/windows-smoke.mjs",
    "smoke:providers": "npm run build && node scripts/providers-smoke.mjs",
    "smoke:client": "npm --prefix server run build && node scripts/client-contract.mjs",
    "smoke:v2": "npm run build && node scripts/v2-smoke.mjs",
    "smoke:local": "npm --prefix server run build && node scripts/local-server-smoke.mjs",
    "smoke:local-app": "npm run build && node scripts/local-app-smoke.mjs",
    "smoke:local-features": "npm run build && node scripts/local-features-smoke.mjs",
    "smoke:server-env": "npm run build && node scripts/server-env-smoke.mjs",
    "smoke:server-integrations": "npm run build && node scripts/server-integrations-smoke.mjs",
    "smoke:server-automations": "npm run build && node scripts/server-automations-smoke.mjs",
    "smoke:server-prwatch": "npm run build && node scripts/server-prwatch-smoke.mjs",
    "smoke:server-review": "npm run build && node scripts/server-review-smoke.mjs",
    "smoke:server-pairing": "npm run build && node scripts/server-pairing-smoke.mjs",
    "smoke:server-move": "npm run build && node scripts/server-move-smoke.mjs",
    "smoke:server-promote": "npm run build && node scripts/server-promote-smoke.mjs",
    "smoke:server-web": "npm run build && node scripts/server-web-smoke.mjs",
    "smoke:server-update": "node scripts/server-update-smoke.mjs",
    "smoke:server-update-app": "npm run build && node scripts/server-update-app-smoke.mjs",
    "smoke:push": "npm --prefix server run build && npm --prefix relay run build && node scripts/push-smoke.mjs",
    "smoke:import": "npm run build && node scripts/import-smoke.mjs",
    "smoke:local-window": "npm run build && node scripts/local-window-smoke.mjs",
    "smoke:theme": "npm run build && node scripts/theme-smoke.mjs",
    "smoke:packaged": "node scripts/smoke-packaged.mjs",
    "rebuild": "electron-rebuild -f -w node-pty",
    "dist": "npm run build && electron-builder --mac --arm64 --publish never",
    "dist:dir": "npm run build && electron-builder --mac --arm64 --dir --publish never",
    "dist:linux": "npm run build && electron-builder --linux deb --publish never",
    "dist:linux:dir": "npm run build && electron-builder --linux dir --publish never",
    "dist:win": "npm run build && electron-builder --win nsis --x64 --publish never",
    "dist:win:dir": "npm run build && electron-builder --win dir --x64 --publish never"
  },
  "build": {
    "appId": "com.trek.trekdev",
    "productName": "Trek",
    "publish": {
      "provider": "github",
      "owner": "gettrekapp",
      "repo": "trek"
    },
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**",
      "resources/**",
      "!**/node_modules/node-pty/{deps,third_party,src}/**"
    ],
    "fileAssociations": [
      {
        "ext": "trekproj",
        "name": "Trek Project",
        "role": "Editor",
        "mimeType": "application/x-trekproj"
      }
    ],
    "asarUnpack": [
      "**/node_modules/node-pty/**"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "resources/AppIcon.icns",
      "category": "public.app-category.developer-tools",
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.inherit.plist",
      "extendInfo": {
        "NSAppleEventsUsageDescription": "Trek Dev switches to an already-open Chrome tab when opening a link."
      },
      "files": [
        "!**/node_modules/node-pty/prebuilds/{win32-*,darwin-x64}/**"
      ]
    },
    "linux": {
      "target": [
        {
          "target": "deb",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "executableName": "trek",
      "icon": "build/icons",
      "category": "Development",
      "synopsis": "Multi-worktree workspace for coding agents",
      "description": "Trek runs coding agents (Claude Code, Codex, Gemini, Grok) across git worktrees, on this computer or on a trek-server.",
      "maintainer": "Trek <gettrekapp@users.noreply.github.com>",
      "vendor": "Trek",
      "desktop": {
        "entry": {
          "StartupWMClass": "trek"
        }
      },
      "files": [
        "!**/node_modules/node-pty/prebuilds/**"
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icons/256x256.png",
      "artifactName": "${productName}-${version}-win-${arch}.${ext}",
      "signExts": [
        ".node",
        ".dll"
      ],
      "files": [
        "!**/node_modules/node-pty/prebuilds/{darwin-*,win32-arm64}/**"
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Trek",
      "deleteAppDataOnUninstall": false
    },
    "deb": {
      "packageName": "trek",
      "priority": "optional"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@types/node": "^26.1.1",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "esbuild": "0.25.12",
    "playwright-core": "^1.61.1",
    "qrcode": "^1.5.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "zustand": "^5.0.14"
  }
}
