# systemd user unit — install with:
#   mkdir -p ~/.config/systemd/user
#   cp trek-daemon.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now trek-daemon
#   loginctl enable-linger $USER   # keep it (and Claude sessions) running after logout
#
# Run `npm run build` in daemon/ first. Adjust WorkingDirectory and the
# ExecStart path to wherever you cloned the repo.
[Unit]
Description=Trek Dev companion daemon
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/Trek.Developer/daemon
ExecStart=/usr/bin/env node %h/Trek.Developer/daemon/dist/trek-daemon.cjs start
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
