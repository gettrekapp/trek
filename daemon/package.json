{
  "name": "trek-daemon",
  "version": "0.1.0",
  "description": "Companion daemon: remote worktrees and Claude sessions for Trek Dev",
  "private": true,
  "bin": {
    "trek-daemon": "dist/trek-daemon.cjs"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
